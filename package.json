{
  "name": "benchmarkwatcher",
  "scripts": {
    "preview:fixture": ".venv/bin/python -m tests.e2e.server --workbooks",
    "test:chat": "playwright test --config playwright.chat.config.ts",
    "test": "jest",
    "build:css": "npx tailwindcss -c tailwind.web.config.js -i app/static/css/tailwind.input.css -o app/static/css/tailwind.css --minify",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run check:ui && npm test && npm run test:e2e && npm run test:chat && npm run test:visuals && npm run test:companies && npm run test:builder && npm run test:diagrams && npm run test:ui",
    "check:vocab": "node scripts/check-vocab.js --fail-on-warn",
    "ci:preflight": "npm run check:ui && npm run check:vocab && npm test && npm run test:e2e && npm run test:chat && npm run test:visuals && npm run test:companies && npm run test:builder && npm run test:diagrams && npm run test:ui",
    "test:visuals": "playwright test --config playwright.d3.config.ts",
    "test:companies": "playwright test --config playwright.companies.config.ts",
    "test:builder": "playwright test --config playwright.builder.config.ts",
    "test:diagrams": "playwright test --config playwright.diagrams.config.ts",
    "build:ui": "node scripts/build_reui.mjs",
    "check:ui": "tsc -p frontend/reui/tsconfig.json",
    "test:ui": "playwright test --config playwright.reui.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "8.5.31",
    "postcss-prefix-selector": "2.2.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-reui": "npm:tailwindcss@4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  }
}
